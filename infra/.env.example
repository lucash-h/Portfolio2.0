# Portfolio 2.0 - Local Deployment Configuration
#
# This file documents all environment variables the stack reads.
# Copy this to `.env` and customize for your deployment.
#
# Local Development: Use the defaults below; stack runs on localhost:80 with plain HTTP
# Production: Change DOMAIN and database credentials as noted below

# ============================================================================
# DOMAIN & TLS
# ============================================================================
# Determines whether Caddy uses plain HTTP (localhost) or automatic HTTPS (real domain)
#
# LOCAL:      Leave unset or set to "localhost" → serves plain HTTP on :80
# PRODUCTION: Set to your domain (e.g., "portfolio.example.com") → automatic HTTPS on :443
#             **Must be a valid, publicly resolvable domain for TLS provisioning**
#
# REQUIRED FOR PRODUCTION: Change this
DOMAIN=:80

# ============================================================================
# DATABASE
# ============================================================================
# Postgres connection credentials. These are baked into DATABASE_URL below.
#
# LOCAL:      Defaults are fine (username: postgres, password: postgres)
# PRODUCTION: **MUST change these to strong, random values**
#             Generate with: openssl rand -base64 32

# Postgres username
# REQUIRED FOR PRODUCTION: Change this to a non-default value
POSTGRES_USER=postgres

# Postgres password
# REQUIRED FOR PRODUCTION: Change this to a strong, random value
# WARNING: Contains special characters in production; if using special chars,
#          ensure DATABASE_URL below is properly URL-encoded
POSTGRES_PASSWORD=postgres

# Postgres database name
# Local default is fine; can be customized if needed
POSTGRES_DB=portfolio

# ============================================================================
# APPLICATION
# ============================================================================
# Node.js app configuration

# Port the SvelteKit app listens on inside the container
# Caddy reverse-proxies to this port; no need to change for local development
# For production, leave at 3000 unless you have a specific reason to change
PORT=3000

# The app derives its public origin (canonical URLs, Open Graph image URLs)
# from Caddy's X-Forwarded-Proto / X-Forwarded-Host headers, which are wired up
# in docker-compose.yml and need no configuration here. If you ever run the app
# WITHOUT Caddy in front of it, set ORIGIN to the public URL instead, e.g.
#   ORIGIN=https://portfolio.example.com

# Complete Postgres connection string for the app
# Interpolates POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB above
# Format: postgresql://user:password@host:port/database
# The host "postgres" is the Docker service name (local) / DB server hostname (production)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# ============================================================================
# CADDY / TLS
# ============================================================================
# These are managed automatically by Caddy based on DOMAIN above.
# Certificates are stored in named Docker volumes (caddy_data, caddy_config)
# and survive container restarts.
#
# No manual configuration needed; Caddy handles ACME registration and renewal.
