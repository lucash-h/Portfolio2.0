# Build context root is the repo root (..)
# These patterns prevent unnecessary files from being copied into the Docker build

# Node artifacts
node_modules
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# SvelteKit build artifacts
.svelte-kit
.next
dist
build

# Version control
.git
.gitignore
.gitattributes

# Environment files
.env
.env.local
.env.*.local

# Python / ML (never deployed)
ml/
__pycache__
*.py[cod]
*.egg-info
.venv
venv

# IDE / Editor
.vscode
.idea
*.swp
*.swo
*~
.DS_Store

# Logs
logs
*.log

# Temporary files
tmp
temp
.cache
