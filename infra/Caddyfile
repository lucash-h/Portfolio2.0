# One file, two modes.
#
#   Local  (DOMAIN unset)          -> site address ":80", plain HTTP, no TLS
#   Prod   (DOMAIN=example.com)    -> automatic HTTPS via Let's Encrypt
#
# The mechanism is the site address itself: `{$DOMAIN::80}` substitutes the
# DOMAIN environment variable at parse time, falling back to ":80". Caddy then
# does the right thing for each, including the HTTP->HTTPS redirect in
# production, which it adds automatically for a named host. There is no
# conditional logic to get wrong.

{$DOMAIN::80} {
	encode gzip zstd

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Do not advertise the server software.
		-Server
	}

	# HSTS only where TLS is actually in use. Sending it over plain HTTP on
	# localhost would teach the browser to force HTTPS for every other local
	# dev server on the machine, which is a genuinely annoying thing to undo.
	# "preload" is deliberately omitted: it is a long-term commitment that
	# should be an explicit decision, not a default.
	@https expression {scheme} == "https"
	header @https Strict-Transport-Security "max-age=31536000; includeSubDomains"

	# Caddy sets X-Forwarded-For, -Proto and -Host on its own; setting them
	# again here would append duplicates.
	reverse_proxy web:3000

	log {
		output stdout
		format json
	}
}
