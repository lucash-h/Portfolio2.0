# Caddyfile - Two-mode deployment
#
# Supports both local development and production deployment via environment variables.
# Uses a snippet-based approach with conditional logic:
#
# Local development (DOMAIN unset or "localhost"):
#   - Serves plain HTTP on :80
#   - No TLS certificate required
#   - Useful for `docker compose up` on a laptop
#
# Production (DOMAIN set to real hostname):
#   - Serves HTTPS on :443 with automatic Let's Encrypt certificate
#   - Redirects HTTP :80 to HTTPS
#   - Adds HSTS header for security
#
# Mechanism: The site block uses {env.DOMAIN|localhost} to expand to either
# the real domain (auto-HTTPS) or localhost (plain HTTP). Caddy sees different
# hostnames at startup and provisions certificates accordingly.

# Shared configuration snippets

(reverse_proxy_headers) {
  reverse_proxy web:3000 {
    header_up X-Forwarded-For {http.request.remote.host}
    header_up X-Forwarded-Proto {http.request.scheme}
    header_up X-Forwarded-Host {http.request.host}
  }
}

(security_headers_base) {
  header X-Content-Type-Options "nosniff"
  header X-Frame-Options "DENY"
  header Referrer-Policy "strict-origin-when-cross-origin"
}

(security_headers_production) {
  import security_headers_base
  header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
}

(compression_logging) {
  encode gzip zstd
  log {
    output stdout
    format json
  }
}

# Main site block
# Expands {env.DOMAIN|localhost} to either real domain or localhost
# Caddy automatically provisions HTTPS for real domains, plain HTTP for localhost
{env.DOMAIN|localhost} {
  # Use internal TLS for localhost (no external cert needed)
  @is_localhost {
    host localhost 127.0.0.1
  }

  handle @is_localhost {
    tls internal
  }

  # For non-localhost (production), Caddy auto-provisions Let's Encrypt certs
  # and automatically applies HTTPS

  # Import reverse proxy
  import reverse_proxy_headers

  # Apply appropriate security headers based on environment
  @is_production {
    not {
      host localhost 127.0.0.1
    }
  }

  handle @is_production {
    # Production: strict security headers with HSTS
    import security_headers_production
  }

  handle {
    # Local development: basic headers
    import security_headers_base
  }

  # Compression and logging (all environments)
  import compression_logging
}

# HTTP-to-HTTPS redirect for production domains
# This catches HTTP requests to non-localhost domains
@redirect_to_https {
  not {
    host localhost 127.0.0.1
  }
  scheme http
}

handle @redirect_to_https {
  redir https://{host}{uri} permanent
}

# Fallback HTTP handler for any unmatched requests
:80 {
  import reverse_proxy_headers
  import security_headers_base
  import compression_logging
}
